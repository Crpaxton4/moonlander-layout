# Whitespace and line rules for all files. editorconfig-checker enforces them, and
# Prettier and shfmt also read them. The model is the .editorconfig of QMK upstream.
root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 88

# This agrees with the YAML format of GitHub Actions.
[*.{yaml,yml}]
indent_size = 2

# Pinned action SHAs and image digests cannot wrap.
[.github/workflows/*.{yaml,yml}]
max_line_length = off

# JSON contains values that cannot wrap, for example schema URLs. Prettier still
# formats JSON.
[*.json]
max_line_length = off

# In Markdown, two trailing spaces are a line break.
[*.md]
trim_trailing_whitespace = false

# make requires tabs in recipes.
[{Makefile,*.mk}]
indent_style = tab

# A keymap grid file keeps each keyboard row on one line, at any length.
[*.inc]
max_line_length = off

# The goldens of the standards checker contain its output without change: one
# finding on each line, at any length of path and message.
[*.expected]
max_line_length = off

# shfmt: when a line continues with \, the next line starts with the &&, || or |
# operator.
[*.sh]
binary_next_line = true
