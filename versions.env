# setup.sh and CI read these pins, so both install the same tool releases
NODE_VERSION=26.13.0
# clang-tidy and clang-format must come from the same LLVM release, so keep the
# mirrors-clang-format rev in .pre-commit-config.yaml equal to this value
LLVM_VERSION=23.1.3
UV_VERSION=0.13.7
PRE_COMMIT_VERSION=4.7.0
SHELLCHECK_VERSION=0.9.0-1
TREE_SITTER_VERSION=0.20.8-2
TREE_SITTER_C_VERSION=0.20.5-2
JQ_VERSION=1.7.1-3ubuntu0.24.04.2
DOXYGEN_VERSION=1.18.0
DOXYGEN_SHA256=14fa81bdc34171edb5f1f02b1d60e74802f0439b77fa44e592565d517d72df90
