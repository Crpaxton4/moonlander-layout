# setup.sh and CI read these pins, so both install the same tool releases
NODE_VERSION=26.13.0
# clang-tidy and clang-format must come from the same LLVM release, so keep the
# mirrors-clang-format rev in .pre-commit-config.yaml equal to this value
LLVM_VERSION=23.1.3
UV_VERSION=0.13.7
PRE_COMMIT_VERSION=4.7.0
SHELLCHECK_VERSION=0.9.0-1
TREE_SITTER_VERSION=0.20.8-2
TREE_SITTER_C_VERSION=0.20.5-2
# gcc-mingw-w64-x86-64-win32 package that builds the converter for Windows
MINGW_VERSION=13.2.0-6ubuntu1+26.1
DOXYGEN_VERSION=1.18.0
DOXYGEN_SHA256=14fa81bdc34171edb5f1f02b1d60e74802f0439b77fa44e592565d517d72df90
# PJRC puts the hid_listen version only in the name of its zip file, so the hash
# pins the zip with the Windows hid_listen.exe in it
HID_LISTEN_VERSION=1.01
HID_LISTEN_SHA256=9cc73e325dc9265c032c295d93e16aad63e01214f69ee788b0b80cbc16d3b076
CMAKE_VERSION=3.28.3-1build7
CMOCKA_VERSION=1.1.7-3
GCOVR_VERSION=8.6
# Mutation build compiles with this clang-18 package. Each Mull plugin package is
# for one LLVM release, so a new clang release needs the Mull plugin package of that
# release
CLANG_VERSION=1:18.1.3-1ubuntu1
MULL_VERSION=0.37.0
# Mull package with mull-runner and mull-reporter
MULL_SHA256=d8c804720ca494d03d5b25dce4cb898a26089c9745831df161c140739a74d856
# Mull plugin package for LLVM 18.1.3
MULL_PLUGIN_SHA256=dab4e04a1342cb4fdc034bf80d9282a458d31a82d8ba01494cb1f6de9d6d102b
# Static ccache release that CI uses for the firmware, host and test builds
CCACHE_VERSION=4.14.2
CCACHE_SHA256=b20ff6415151226ac5a10dfd6839700c694bd67d1871c8fddb266d366ff25bfb
# CI firmware build uses the releases of the QMK qmk_cli 1.2.0 image. A new release
# changes the firmware bytes, so change each release and its sha256 by hand
QMK_TOOLCHAINS_RELEASE=v15.2.0-1
QMK_TOOLCHAINS_SHA256=6b136919e3526f3f373e91f7d011a006e968a3169262d33cf6efa3e6c605c3ca
QMK_FLASHUTILS_RELEASE=20260318
QMK_FLASHUTILS_SHA256=acb2f17ff5e6c555c657d0203fe647ea535fa98d214af8bf428015c7d0a20a15
QMK_CLI_VERSION=1.2.0
# uv uses PyPI as it was at this time, so all CI runs install the same versions
QMK_PYTHON_DEPS_DATE=2026-11-05T00:00:00Z
# `qmk compile` never gets a missing submodule, so this comma-separated list must
# contain all submodules that the CI firmware build needs
QMK_SUBMODULES=lib/chibios,lib/chibios-contrib,lib/lufa,lib/printf,modules/zsa
