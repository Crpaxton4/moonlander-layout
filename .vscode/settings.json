{
    "editor.formatOnSave": true,
    "editor.rulers": [88],
    // VS Code treats .h as C++ by default; *.inc files are keymap fragments
    // included into C
    "files.associations": {
        "*.h": "c",
        "*.inc": "c"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[json][jsonc][yaml][markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "clangd.arguments": [
        // Lets clangd run the QMK toolchain's gcc to learn its target and
        // system headers
        "--query-driver=**/arm-none-eabi-gcc",
        // QMK code reaches its headers through QMK_KEYBOARD_H, so completion
        // must not add direct includes
        "--header-insertion=never"
    ]
}
