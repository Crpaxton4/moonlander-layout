---
# clang-diagnostic-* entries let the ExtraArgsBefore warnings pass the -*
# filter. bugprone-signed-bitwise reports each use of the QMK keycode macros
Checks: >-
    -*,
    bugprone-*,
    -bugprone-signed-bitwise,
    clang-analyzer-*,
    readability-function-size,
    readability-function-cognitive-complexity,
    readability-magic-numbers,
    readability-implicit-bool-conversion,
    readability-identifier-naming,
    clang-diagnostic-documentation,
    clang-diagnostic-documentation-unknown-command
WarningsAsErrors: "*"

HeaderFilterRegex: "/src/qmk/keyboards/"

# clang does not know the gcc flags. -Werror bypasses Checks, and the macro causes
# a finding that HeaderFilterRegex cannot exclude
RemovedArgs:
    - -mno-thumb-interwork
    - -fsingle-precision-constant
    - -fanalyzer
    - -Wduplicated-cond
    - -Wduplicated-branches
    - -Wlogical-op
    - -Wjump-misses-init
    - -Werror
    - -DQMK_MCU_ARCH=cortex-m4

# clang-tidy puts ExtraArgs after the `--` of the inferred keymap.c command, where
# the compiler reads them as file names
ExtraArgsBefore:
    - -Wdocumentation
    - -Wdocumentation-unknown-command

CheckOptions:
    readability-function-size.LineThreshold: 25
    readability-function-cognitive-complexity.Threshold: 8
    # QMK macros such as wait_ms() hide control flow that counts against each caller
    readability-function-cognitive-complexity.IgnoreMacros: true

    # Literals in #define, enum and const initializers never cause a finding
    readability-magic-numbers.IgnoredIntegerValues: ""
    readability-magic-numbers.IgnorePowersOf2IntegerValues: false
    readability-magic-numbers.IgnoredFloatingPointValues: ""
    readability-magic-numbers.IgnoreAllFloatingPointValues: false

    readability-identifier-naming.FunctionCase: lower_case
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.TypedefCase: lower_case
    readability-identifier-naming.TypedefSuffix: _t
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
    readability-identifier-naming.EnumConstantCase: UPPER_CASE
