---
# Each finding is an error, so the exit status is not zero if there is a finding.
# clang-tidy still analyzes all files first.
#
# ExtraArgsBefore below adds -Wdocumentation and -Wdocumentation-unknown-command.
# Their clang-diagnostic-* entries let them pass the -* filter.
#
# bugprone-signed-bitwise is off. It reports the int keycode macros of QMK (LCTL,
# LSFT, LT, TD, LAYOUT and others) at each use. It never reports the bitwise logic
# of this userspace.
Checks: >-
    -*,
    bugprone-*,
    -bugprone-signed-bitwise,
    clang-analyzer-*,
    readability-function-size,
    readability-function-cognitive-complexity,
    readability-magic-numbers,
    readability-implicit-bool-conversion,
    readability-identifier-naming,
    clang-diagnostic-documentation,
    clang-diagnostic-documentation-unknown-command
WarningsAsErrors: "*"

# clang-tidy reports only the keyboards tree of this userspace, never QMK or
# ChibiOS.
HeaderFilterRegex: "/src/qmk/keyboards/"

# The compile database contains arm-none-eabi-gcc commands. clang gets its target
# from the name of the gcc driver. clang cannot use these arguments:
# - -mno-thumb-interwork: clang does not know this flag. It is a hard error.
# - -fsingle-precision-constant: clang does not support this optimization flag.
# - -Werror: it makes compiler warnings into errors that Checks does not control.
# - -DQMK_MCU_ARCH=cortex-m4: only make reads it, and no C code uses it. Its
#   replacement list causes a bugprone-macro-parentheses finding at a command-line
#   location. HeaderFilterRegex cannot exclude that location.
RemovedArgs:
    - -mno-thumb-interwork
    - -fsingle-precision-constant
    - -Werror
    - -DQMK_MCU_ARCH=cortex-m4

# Use ExtraArgsBefore, not ExtraArgs. keymap.c has no compile database entry, so
# clang-tidy infers its command. clang-tidy adds ExtraArgs after the `--` at the
# end of that command, where the compiler reads them as file names.
ExtraArgsBefore:
    - -Wdocumentation
    - -Wdocumentation-unknown-command

CheckOptions:
    readability-function-size.LineThreshold: 25
    readability-function-cognitive-complexity.Threshold: 8
    # QMK macros hide control flow. For example, wait_ms() expands to do/if/else.
    # Without this option, that control flow counts against each function that
    # calls the macros.
    readability-function-cognitive-complexity.IgnoreMacros: true

    # The check accepts only 0. It never reports literals in #define, enum and
    # const initializers.
    readability-magic-numbers.IgnoredIntegerValues: ""
    readability-magic-numbers.IgnorePowersOf2IntegerValues: false
    readability-magic-numbers.IgnoredFloatingPointValues: ""
    readability-magic-numbers.IgnoreAllFloatingPointValues: false

    readability-identifier-naming.FunctionCase: lower_case
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.TypedefCase: lower_case
    readability-identifier-naming.TypedefSuffix: _t
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
    readability-identifier-naming.EnumConstantCase: UPPER_CASE
