{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "displayName": "Development",
            "description": "Firmware, host programs and unit tests, built in .build/cmake/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/cmake",
            "cacheVariables": {
                "MOONLANDER_PARTS": "firmware;checker;converter;unit-tests"
            }
        },
        {
            "name": "firmware",
            "displayName": "Firmware",
            "description": "Firmware and keymap compile database only, built in .build/firmware/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/firmware",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": null,
                "MOONLANDER_PARTS": "firmware"
            }
        },
        {
            "name": "checker",
            "displayName": "Standards checker",
            "description": "Standards checker only, built in .build/checker/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/checker",
            "cacheVariables": {
                "MOONLANDER_PARTS": "checker"
            }
        },
        {
            "name": "converter",
            "displayName": "Key log converter",
            "description": "Key log converter only, built in .build/converter/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/converter",
            "cacheVariables": {
                "MOONLANDER_PARTS": "converter"
            }
        },
        {
            "name": "unit-tests",
            "displayName": "Unit tests",
            "description": "Keymap unit tests only, built in .build/unit-tests/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/unit-tests",
            "cacheVariables": {
                "MOONLANDER_PARTS": "unit-tests"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows key log converter",
            "description": "Key log converter for Windows, built in .build/windows/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/windows",
            "toolchainFile": "${sourceDir}/src/ci/mingw-w64-toolchain.cmake",
            "cacheVariables": {
                "MOONLANDER_PARTS": "converter"
            }
        },
        {
            "name": "coverage",
            "displayName": "Test coverage",
            "description": "Host programs and unit tests with gcov counters, built in .build/coverage/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MOONLANDER_COVERAGE": "ON",
                "MOONLANDER_PARTS": "checker;converter;unit-tests"
            }
        },
        {
            "name": "mutation",
            "displayName": "Mutation testing",
            "description": "Host programs and unit tests with Mull mutants, built with clang in .build/mutation/",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/mutation",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang-18",
                "MOONLANDER_MUTATION": "ON",
                "MOONLANDER_PARTS": "checker;converter;unit-tests"
            }
        },
        {
            "name": "mutation-diff",
            "displayName": "Mutation testing of the changes",
            "description": "Mutation build that runs only the mutants on lines that differ from origin/main, in .build/mutation-diff/",
            "inherits": "mutation",
            "binaryDir": "${sourceDir}/.build/mutation-diff",
            "cacheVariables": {
                "MUTATION_DIFF_REF": "origin/main"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev"
        },
        {
            "name": "build",
            "configurePreset": "dev",
            "targets": ["all", "compile-databases", "debug-firmware", "memory-report"]
        },
        {
            "name": "compile-databases",
            "configurePreset": "dev",
            "targets": ["compile-databases", "debug-firmware"]
        },
        {
            "name": "analyze",
            "configurePreset": "dev",
            "targets": ["analyze"],
            "nativeToolOptions": ["--keep-going"]
        },
        {
            "name": "firmware",
            "configurePreset": "firmware",
            "targets": ["firmware"]
        },
        {
            "name": "debug-firmware",
            "configurePreset": "firmware",
            "targets": ["debug-firmware"]
        },
        {
            "name": "memory-report",
            "configurePreset": "firmware",
            "targets": ["memory-report"]
        },
        {
            "name": "checker",
            "configurePreset": "checker"
        },
        {
            "name": "converter",
            "configurePreset": "converter"
        },
        {
            "name": "unit-tests",
            "configurePreset": "unit-tests"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        },
        {
            "name": "coverage-gate",
            "configurePreset": "coverage",
            "targets": ["coverage-gate"],
            "nativeToolOptions": ["--keep-going"]
        },
        {
            "name": "mutation",
            "configurePreset": "mutation",
            "targets": ["mutation"]
        },
        {
            "name": "mutation-diff",
            "configurePreset": "mutation-diff",
            "targets": ["mutation"]
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "configurePreset": "dev"
        },
        {
            "name": "checker",
            "inherits": "base",
            "configurePreset": "checker"
        },
        {
            "name": "converter",
            "inherits": "base",
            "configurePreset": "converter"
        },
        {
            "name": "unit-tests",
            "inherits": "base",
            "configurePreset": "unit-tests"
        },
        {
            "name": "coverage",
            "inherits": "base",
            "configurePreset": "coverage"
        }
    ],
    "workflowPresets": [
        {
            "name": "firmware",
            "displayName": "Firmware",
            "steps": [
                { "type": "configure", "name": "firmware" },
                { "type": "build", "name": "firmware" }
            ]
        },
        {
            "name": "debug-firmware",
            "displayName": "Profiling debug firmware and its compile database",
            "steps": [
                { "type": "configure", "name": "firmware" },
                { "type": "build", "name": "debug-firmware" }
            ]
        },
        {
            "name": "memory-report",
            "displayName": "Firmware, debug firmware, then the memory report",
            "steps": [
                { "type": "configure", "name": "firmware" },
                { "type": "build", "name": "firmware" },
                { "type": "build", "name": "debug-firmware" },
                { "type": "build", "name": "memory-report" }
            ]
        },
        {
            "name": "build",
            "displayName": "Firmware, debug firmware, compile databases, host programs, unit tests and memory report",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "build" }
            ]
        },
        {
            "name": "compile-databases",
            "displayName": "Firmware, debug firmware and compile databases",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "compile-databases" }
            ]
        },
        {
            "name": "all",
            "displayName": "Build, then static analysis",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "build" },
                { "type": "build", "name": "analyze" }
            ]
        },
        {
            "name": "analyze",
            "displayName": "Static analysis",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "analyze" }
            ]
        },
        {
            "name": "test",
            "displayName": "All tests",
            "steps": [
                { "type": "configure", "name": "dev" },
                { "type": "build", "name": "dev" },
                { "type": "test", "name": "dev" }
            ]
        },
        {
            "name": "checker-test",
            "displayName": "Standards checker tests",
            "steps": [
                { "type": "configure", "name": "checker" },
                { "type": "build", "name": "checker" },
                { "type": "test", "name": "checker" }
            ]
        },
        {
            "name": "converter-test",
            "displayName": "Key log converter tests",
            "steps": [
                { "type": "configure", "name": "converter" },
                { "type": "build", "name": "converter" },
                { "type": "test", "name": "converter" }
            ]
        },
        {
            "name": "qmk-test",
            "displayName": "Keymap unit tests",
            "steps": [
                { "type": "configure", "name": "unit-tests" },
                { "type": "build", "name": "unit-tests" },
                { "type": "test", "name": "unit-tests" }
            ]
        },
        {
            "name": "windows",
            "displayName": "Windows key log converter",
            "steps": [
                { "type": "configure", "name": "windows" },
                { "type": "build", "name": "windows" }
            ]
        },
        {
            "name": "coverage",
            "displayName": "Test coverage, then the coverage gate",
            "steps": [
                { "type": "configure", "name": "coverage" },
                { "type": "build", "name": "coverage" },
                { "type": "test", "name": "coverage" },
                { "type": "build", "name": "coverage-gate" }
            ]
        },
        {
            "name": "mutation",
            "displayName": "Mutation testing of all code under test",
            "steps": [
                { "type": "configure", "name": "mutation" },
                { "type": "build", "name": "mutation" }
            ]
        },
        {
            "name": "mutation-diff",
            "displayName": "Mutation testing of the changes, then the mutation gate",
            "steps": [
                { "type": "configure", "name": "mutation-diff" },
                { "type": "build", "name": "mutation-diff" }
            ]
        }
    ]
}
