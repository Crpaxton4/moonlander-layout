/** @file
 * Launcher layer lighting: the leader chord macro keys pink, three keys pale
 * blue, the top left key back to the base layer white, and the remaining lights
 * as on the base layer.
 */

// clang-format off
[LAYER_LAUNCHER] = {
    // left half, outer column first
    COLOR_WHITE,     COLOR_PALE_BLUE, COLOR_OFF,      COLOR_OFF,    COLOR_OFF,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_OFF,
    COLOR_PINK,      COLOR_PINK,      COLOR_PINK,     COLOR_OFF,    COLOR_GREEN_92,
    COLOR_PINK,      COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_PINK,
    COLOR_PALE_BLUE, COLOR_PINK,      COLOR_PINK,     COLOR_OFF,    COLOR_PURPLE_186,
    COLOR_PALE_BLUE, COLOR_PINK,      COLOR_PINK,     COLOR_PINK,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,
    // left thumb keys, then the large thumb key
    COLOR_OFF,       COLOR_OFF,       COLOR_OFF,      COLOR_OFF,
    // right half, outer column first
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_PINK,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_BLUE_179,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_BLUE_179,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_BLUE_179,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,   COLOR_BLUE_179,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,     COLOR_PINK,
    COLOR_OFF,       COLOR_PINK,      COLOR_PINK,
    // right thumb keys, then the large thumb key
    COLOR_BLUE_180,  COLOR_BLUE_179,  COLOR_BLUE_179, COLOR_ORANGE
},
    // clang-format on
