# clangd reads the compile database from `make -C src compiledb`, which holds
# arm-none-eabi-gcc commands. --query-driver is a clangd command-line flag, so
# it is set in .vscode/settings.json.
CompileFlags:
    # Doxygen comments are checked as you type: @param names must match the
    # signature, and unknown commands are flagged
    Add: [-Wdocumentation, -Wdocumentation-unknown-command]
    Remove:
        # GCC-only flags that clang rejects or ignores with a warning
        - -mno-thumb-interwork
        - -fsingle-precision-constant
        # Editor diagnostics stay warnings; the firmware build keeps -Werror
        - -Werror
